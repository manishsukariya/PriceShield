NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/priceshield_dev"
# Set a unique, high-entropy secret in your local .env. Never commit it.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
DEV_OTP_FALLBACK=false
# Create a Resend API key and verify the sender address in Resend. Keep both local.
RESEND_API_KEY=
RESEND_FROM_EMAIL="PriceShield <onboarding@resend.dev>"
CORS_ALLOWED_ORIGIN=
