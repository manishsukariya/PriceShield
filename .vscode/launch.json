{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PriceShield: USB phone with local API",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=PRICESHIELD_API_BASE_URL=http://192.168.0.107:3000"
